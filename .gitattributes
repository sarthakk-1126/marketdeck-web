# PDFs must retain byte offsets; never apply automatic newline conversion.
*.pdf binary
*.webp binary
# Generated vendor bundle contains intentional GLSL whitespace. Preserve its bytes.
public/assets/globe.js -text -whitespace linguist-generated=true

# Frozen research artifacts must not change bytes between Windows and Linux.
/scripts/research/canonical_metrics.py text eol=lf
/content/research/var-simulation-results.json text eol=lf
/content/articles/when-var-methods-disagree.md text eol=lf
/docs/research/var-validation.json text eol=lf
/public/assets/research/*.svg text eol=lf
