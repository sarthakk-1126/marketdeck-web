{
  "name": "marketdeck-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/bundle.mjs && node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check public/home.js && node --check public/experience.js && node --check src/globe.js && node --check scripts/build.mjs && node --check scripts/editorial.mjs && node --check scripts/dev.mjs && npm test",
    "build:review": "node scripts/build.mjs --review",
    "dev:review": "node scripts/dev.mjs --review",
    "test:browser": "playwright test",
    "brief:generate": "python scripts/generate-brief.py"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "esbuild": "0.25.12",
    "simple-icons": "15.20.0"
  }
}
